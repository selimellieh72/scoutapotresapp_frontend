{
  "expo": {
    "name": "Scout des Apôtres",
    "slug": "scout-des-apotres",
    "version": "0.1.0",
    "scheme": "scoutapotres",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Scout des Apôtres"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your group's posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-image"
    ]
  }
}
