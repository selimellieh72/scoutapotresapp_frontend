{
  "expo": {
    "name": "Scout des Apotres",
    "slug": "scout-des-apotres",
    "version": "0.1.0",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "scoutapotres",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "org.scoutsdesapotres.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDisplayName": "Scout des Apôtres"
      }
    },
    "android": {
      "package": "com.scoutsdesapotres.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/android-adaptive-foreground.png",
        "backgroundColor": "#04311F"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/brand/app-icon.png",
      "output": "single",
      "name": "Scout des Apôtres"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your group's posts.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-video",
      "expo-image",
      "expo-font",
      [
        "./plugins/withAndroidAppName",
        "Scout des Apôtres"
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "24e5c990-5570-4e3a-a61f-8d76185f8d82"
      }
    },
    "owner": "selimellieh"
  }
}
